# Trading mode — default dry_run (safest). Live requires triple opt-in below.
TRADING_MODE=dry_run
LIVE_TRADING=false
ALLOW_LIVE_ORDERS=false

# Optional profile override (wins over config.yaml profile: key)
# KRAKEN_ALPHA_PROFILE=aggressive_competition

# Shorting requires BOTH env and config.yaml trading.shorting_enabled
SHORTING_ENABLED=false

# Kraken Spot API (read-only for jury; write only when going live)
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Optional dedicated Kraken Futures credentials (https://futures.kraken.com).
# Required only when execution.engine = futures (micro_live_100eur profile).
# When set, the futures CLI wrapper uses them in preference to the spot keys.
# NEVER commit real values — keep them in your local .env only.
KRAKEN_FUTURES_API_KEY=
KRAKEN_FUTURES_API_SECRET=

# Kraken CLI transport: auto | windows | wsl | mock (mock = tests/CI, no binary)
KRAKEN_CLI_TRANSPORT=auto

# Optional LLM explanations (Featherless OpenAI-compatible API)
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=

# Paths (relative to repo root)
DATABASE_PATH=data/agent.sqlite
DECISIONS_LOG_PATH=data/decisions.jsonl
TRADES_LOG_PATH=data/trades.jsonl
PNL_LOG_PATH=data/pnl.jsonl
CONFIG_PATH=config.yaml
LOG_LEVEL=INFO

# Optional actionability overrides (empty = use config.yaml)
# MIN_OPPORTUNITY_SCORE_BUY=
# MIN_OPPORTUNITY_SCORE_SELL=

# Agent loop override (seconds between cycles)
# LOOP_INTERVAL_SECONDS=

# VPS / ops: override repo root detection in observation scripts
# KRAKEN_ALPHA_ROOT=
